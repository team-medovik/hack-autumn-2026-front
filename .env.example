# ─────────────────────────────────────────────────────────────────────────────
# Шаблон переменных окружения.
# Скопируйте в .env.development или .env.production и заполните.
# Сами .env.* файлы не коммитятся (они в .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── API ─────────────────────────────────────────────────────────────────────
# Базовый URL для всех запросов к API (без слэша в конце)
VITE_API_URL=http://localhost:8080/api

# Таймаут запроса в мс (по умолчанию 15000)
# VITE_API_TIMEOUT=15000

# Только для dev-сервера (не VITE_): проксировать /api на этот хост
# DEV_PROXY_TARGET=https://example.com

# ─── DevTools ────────────────────────────────────────────────────────────────
# TanStack Query DevTools и Zustand devtools. По умолчанию: в dev включены, в prod выключены.
# VITE_ENABLE_DEVTOOLS=true

# ─── Моки ────────────────────────────────────────────────────────────────────
# MSW в браузере (src/app/mocks). По умолчанию: в dev включены, в prod выключены.
# Без правки файла: `npm run dev:mocks` (вкл) / `npm run dev:api` (реальный бэкенд).
# Вход в моках: admin / Admin123.
# Сценарий дашборда переключается через ?mock=<name> в адресе страницы,
# см. src/app/mocks/dashboard/handlers.ts.
# VITE_ENABLE_MOCKS=true

# ─── Анализ бандла ───────────────────────────────────────────────────────────
# Запуск: ANALYZE=true npm run build  (не VITE_-переменная, читается только vite.config.ts)
# ANALYZE=true
