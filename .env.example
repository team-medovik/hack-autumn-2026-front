# ─────────────────────────────────────────────────────────────────────────────
# Environment variables template.
# Copy to .env.development or .env.production and fill in values.
# Never commit actual .env.* files (they are in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL for all API requests (no trailing slash)
VITE_API_URL=http://localhost:8080/api

# Request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT=15000

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_TITLE=My App
VITE_APP_ENV=development

# ─── DevTools ────────────────────────────────────────────────────────────────
# Set to "true" to show TanStack Query DevTools and Zustand devtools.
# Automatically true in development, false in production.
VITE_ENABLE_DEVTOOLS=true

# ─── Mocks ───────────────────────────────────────────────────────────────────
# MSW in the browser (src/app/mocks). Default: on in development, off in production.
# Without editing this file: `npm run dev:mocks` (on) / `npm run dev:api` (real backend).
# Mock login: admin / Admin123.
# Dashboard scenario is switched with ?mock=<name> in the page URL,
# see src/app/mocks/dashboard/handlers.ts.
# VITE_ENABLE_MOCKS=true

# ─── Bundle Analysis ─────────────────────────────────────────────────────────
# Run: ANALYZE=true npm run build  (not a VITE_ var, used by vite.config.ts only)
# ANALYZE=true
